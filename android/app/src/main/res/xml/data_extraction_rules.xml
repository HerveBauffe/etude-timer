<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde cloud et transfert d'appareil (Android 12+) : device.json (mot de passe WebDAV) exclu. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="etude-timer/device.json"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="etude-timer/device.json"/>
    </device-transfer>
</data-extraction-rules>
